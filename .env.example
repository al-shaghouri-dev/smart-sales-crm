# Copy to .env and fill in values. Never commit .env.
NODE_ENV=development
PORT=3000
# true only when running behind a trusted reverse proxy / load balancer (needed for secure cookies & rate limits)
TRUST_PROXY=false

# ---- PostgreSQL ----
# Application connection: a role WITHOUT superuser / BYPASSRLS so Row Level Security applies.
DATABASE_URL=postgres://sscrm_app:change-me-app@localhost:5432/sscrm
# Migration connection: the schema owner role.
DATABASE_MIGRATION_URL=postgres://sscrm_owner:change-me-owner@localhost:5432/sscrm
# Name of the application role (migrations grant it table privileges).
APP_DB_ROLE=sscrm_app

# Optional: a direct (non-pooled) connection for pg-boss and LISTEN/NOTIFY when DATABASE_URL goes
# through a transaction-mode pooler (e.g. PgBouncer / a provider's "pooled" URL). Same role as DATABASE_URL.
DATABASE_DIRECT_URL=

# ---- Security ----
# Credential encryption key ring (AES-256-GCM). Generate each key with:  openssl rand -base64 32
#   (PowerShell: [Convert]::ToBase64String((1..32 | % { [byte](Get-Random -Max 256) })) )
# Format: id:base64key,id2:base64key   — keep old keys listed until `npm run secrets:rotate` reports 0.
APP_ENCRYPTION_KEYS=
APP_ENCRYPTION_PRIMARY_KEY_ID=
# Older single-key setting (Phases 0-2). Still accepted (used as key id "k1" when APP_ENCRYPTION_KEYS
# is empty) and used to read legacy v1 values. Production requires APP_ENCRYPTION_KEYS or this.
APP_ENCRYPTION_KEY=
SESSION_TTL_HOURS=12
LOGIN_RATE_LIMIT=10

# Super Admin console sessions are shorter than workspace sessions.
PLATFORM_SESSION_TTL_HOURS=4

# ---- Links & email ----
# Public URL of the app; used in invitation and password-reset links.
APP_URL=http://localhost:3000
# MAIL_DRIVER: none (links are shown once to the admin who created them) | smtp
MAIL_DRIVER=none
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ---- Processes & background jobs (pg-boss, stored in PostgreSQL — no external queue) ----
# all = one process does everything (local / single small server)
# web = HTTP API + frontend + Socket.IO (no job workers) · worker = job workers only (no HTTP)
# Also selectable per command: npm start | npm run start:web | npm run start:worker
PROCESS_ROLE=all
JOBS_ENABLED=true
JOBS_POLLING_INTERVAL_SECONDS=2
JOBS_POOL_MAX=4
# Max time to wait for active jobs / connections when stopping (SIGTERM / Ctrl+C).
SHUTDOWN_TIMEOUT_MS=25000

# ---- Real-time (Socket.IO, same origin as the app) ----
REALTIME_ENABLED=true
# none = single instance · postgres = several instances share events via PostgreSQL LISTEN/NOTIFY
REALTIME_ADAPTER=none
# Browser Origins allowed to open a socket (default: APP_URL). With the Vite dev server add it:
#   REALTIME_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
REALTIME_ALLOWED_ORIGINS=
REALTIME_REVALIDATE_SECONDS=60

# ---- Webhooks & channel providers ----
# Enabled provider adapters, comma separated. Real providers arrive in Phase 3.3+ (telegram,
# messenger, instagram, whatsapp). "fake" is a local test provider and is refused in production.
CHANNEL_PROVIDERS=
FAKE_PROVIDER_SECRET=
WEBHOOK_BODY_LIMIT=1mb
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_DELAY_SECONDS=30
WEBHOOK_RETENTION_DAYS=30
WEBHOOK_RATE_LIMIT_PER_MINUTE=1200

# ---- Storage ----
UPLOADS_DIR=./uploads

# ---- Tests (optional; a throwaway database) ----
TEST_DATABASE_URL=postgres://sscrm_app:change-me-app@localhost:5432/sscrm_test
TEST_DATABASE_MIGRATION_URL=postgres://sscrm_owner:change-me-owner@localhost:5432/sscrm_test
TEST_APP_DB_ROLE=sscrm_app

# ---- Legacy prototype (npm run legacy) — Meta settings for the old single-workspace server ----
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v26.0
INSTAGRAM_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
ALLOW_UNSIGNED_WEBHOOKS=false
