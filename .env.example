# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000
# Set to true only when running behind a trusted reverse proxy (needed for secure cookies/rate limits).
TRUST_PROXY=false

# Meta (Messenger / Instagram / WhatsApp) — legacy single-workspace channel settings.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v26.0
INSTAGRAM_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Development only: accept webhooks without a signature when META_APP_SECRET is empty. Ignored in production.
ALLOW_UNSIGNED_WEBHOOKS=false
