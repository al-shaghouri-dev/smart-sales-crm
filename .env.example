# Copy to .env and fill in values. Never commit .env.
NODE_ENV=development
PORT=3000
# true only when running behind a trusted reverse proxy / load balancer (needed for secure cookies & rate limits)
TRUST_PROXY=false

# ---- PostgreSQL ----
# Application connection: a role WITHOUT superuser / BYPASSRLS so Row Level Security applies.
DATABASE_URL=postgres://sscrm_app:change-me-app@localhost:5432/sscrm
# Migration connection: the schema owner role.
DATABASE_MIGRATION_URL=postgres://sscrm_owner:change-me-owner@localhost:5432/sscrm
# Name of the application role (migrations grant it table privileges).
APP_DB_ROLE=sscrm_app

# ---- Security ----
# 32 random bytes, base64 (openssl rand -base64 32). Required in production; used to encrypt stored channel credentials.
APP_ENCRYPTION_KEY=
SESSION_TTL_HOURS=12
LOGIN_RATE_LIMIT=10

# ---- Storage ----
UPLOADS_DIR=./uploads

# ---- Tests (optional; a throwaway database) ----
TEST_DATABASE_URL=postgres://sscrm_app:change-me-app@localhost:5432/sscrm_test
TEST_DATABASE_MIGRATION_URL=postgres://sscrm_owner:change-me-owner@localhost:5432/sscrm_test
TEST_APP_DB_ROLE=sscrm_app

# ---- Legacy prototype (npm run legacy) — Meta settings for the old single-workspace server ----
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v26.0
INSTAGRAM_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
ALLOW_UNSIGNED_WEBHOOKS=false
