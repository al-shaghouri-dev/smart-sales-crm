# =====================================================================================================
# Smart Sales CRM — environment reference
# Copy to `.env` (never commit it) and fill in your own values. Full explanations:
# documentation/ENVIRONMENT.md (docs/ENVIRONMENT.md in the repository).
#
# Legend:  [REQUIRED]  must be set in production
#          [PROD]      required only when NODE_ENV=production (and the related feature is used)
#          [OPTIONAL]  has a safe default
#
# Generators:
#   random hex (URL-safe, for passwords inside connection URLs):  openssl rand -hex 24
#   32-byte base64 key (encryption / signing):                    openssl rand -base64 32
#   Windows PowerShell 32-byte key:
#     $b=New-Object byte[] 32;[Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b);[Convert]::ToBase64String($b)
# =====================================================================================================

# ---------------------------------------------------------------- Runtime
# [REQUIRED] "production" on servers (enables secure cookies, HSTS, strict config checks).
NODE_ENV=production
# [OPTIONAL] HTTP port the Node process listens on (default 3000).
PORT=3000
# [OPTIONAL] all = API + frontend + Socket.IO + background jobs in one process (recommended for one server);
#            web = HTTP/Socket.IO only; worker = background jobs only (scale-out, see DEPLOYMENT.md).
PROCESS_ROLE=all
# [REQUIRED behind a proxy] Number of reverse proxies in front of the app: 1 behind Nginx/a load balancer,
# 2 behind CDN + load balancer. Wrong values break client-IP rate limiting. Empty = no proxy.
TRUST_PROXY=1
# [OPTIONAL] Graceful shutdown budget for running jobs, ms.
SHUTDOWN_TIMEOUT_MS=25000

# ---------------------------------------------------------------- Public addresses
# [REQUIRED] Public https URL users open (used in invitation/reset links and as the allowed Socket.IO origin).
APP_URL=https://crm.example.com
# [OPTIONAL] Public https origin providers call for webhooks and OAuth redirects. Default: APP_URL.
PUBLIC_URL=
# [OPTIONAL] Extra browser origins allowed for Socket.IO (comma separated). Default: APP_URL.
REALTIME_ALLOWED_ORIGINS=

# ---------------------------------------------------------------- Database (PostgreSQL 14+, 16 recommended)
# [REQUIRED] Schema-owner connection used ONLY for migrations / database preparation.
#   postgres://sscrm_owner:<password>@<host>:5432/<database>   (add ?sslmode=require for managed providers)
DATABASE_MIGRATION_URL=postgres://sscrm_owner:CHANGE_ME@db-host:5432/sscrm
# [REQUIRED] Name of the application role. It must NOT be SUPERUSER or BYPASSRLS (Row Level Security).
APP_DB_ROLE=sscrm_app
# [REQUIRED unless DATABASE_URL is set] Password of the application role. scripts/prepare-database.js creates
# the role with it when missing. Use a URL-safe value (openssl rand -hex 24).
APP_DB_PASSWORD=
# [OPTIONAL] Explicit application connection (restricted role). Default: derived from DATABASE_MIGRATION_URL
# with APP_DB_ROLE / APP_DB_PASSWORD.
DATABASE_URL=
# [OPTIONAL] Direct (non-pooled) connection for pg-boss and LISTEN/NOTIFY if DATABASE_URL points to PgBouncer.
DATABASE_DIRECT_URL=
# [OPTIONAL] Max pooled connections for the app (default 10).
DB_POOL_MAX=10

# ---------------------------------------------------------------- Docker Compose only (infrastructure/docker)
# Used by the bundled PostgreSQL container on first start; URL-safe values (openssl rand -hex 24).
POSTGRES_SUPERUSER_PASSWORD=
SSCRM_OWNER_PASSWORD=
SSCRM_APP_PASSWORD=
SSCRM_DB_NAME=sscrm
# Host interface/port for the app container (keep 127.0.0.1 when Nginx runs on the same host).
APP_BIND=127.0.0.1
APP_PORT=3000
# Directory holding fullchain.pem / privkey.pem for the optional Nginx profile.
TLS_CERT_DIR=

# ---------------------------------------------------------------- Secrets & encryption
# [REQUIRED in production] Key ring for encrypting channel tokens: "id:base64key[,id2:base64key2]".
# Generate: openssl rand -base64 32  →  APP_ENCRYPTION_KEYS=k1:<key>. Back it up OUTSIDE the server;
# without it stored channel credentials cannot be decrypted (companies would reconnect channels).
APP_ENCRYPTION_KEYS=
# [REQUIRED with APP_ENCRYPTION_KEYS] Key id used for new encryptions (e.g. k1). Rotation: DEPLOYMENT.md.
APP_ENCRYPTION_PRIMARY_KEY_ID=k1
# [OPTIONAL] Single-key alternative (used as key id "k1" when APP_ENCRYPTION_KEYS is empty).
APP_ENCRYPTION_KEY=
# [PROD, when any channel provider is enabled] Derives per-channel webhook secrets and signs short-lived
# media links / OAuth state. 32+ characters: openssl rand -base64 32
WEBHOOK_SECRET_KEY=

# ---------------------------------------------------------------- First Super Admin (one time)
# [OPTIONAL] Creates the first platform admin on start ONLY if none exists (for hosts without a shell).
# Alternative: npm run platform:admin -- --email you@example.com --name "Name"
# Remove both after the first sign-in and change the password in "My account".
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------- Sessions & rate limits
SESSION_TTL_HOURS=12
PLATFORM_SESSION_TTL_HOURS=4
# Failed sign-in attempts per 15 minutes per IP + account.
LOGIN_RATE_LIMIT=10
# Requests per minute per client IP for /api.
API_RATE_LIMIT_PER_MINUTE=600

# ---------------------------------------------------------------- Files
# [REQUIRED for durable storage] Persistent directory for logos/favicons (served at /uploads).
UPLOADS_DIR=/data/uploads
# Message attachments: local (private directory on a persistent disk) or s3 (any S3-compatible service).
MEDIA_DRIVER=local
# [OPTIONAL] Private media directory (never publicly served). Default: <UPLOADS_DIR>-media.
MEDIA_DIR=/data/media
MEDIA_MAX_BYTES=10485760
# [REQUIRED when MEDIA_DRIVER=s3] Bucket and credentials from your storage provider.
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=auto
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------- Email (optional; without it links are shown once to the admin)
MAIL_DRIVER=
MAIL_FROM="Smart Sales CRM <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------- Background jobs (pg-boss, same database)
JOBS_ENABLED=true
JOBS_SCHEMA=pgboss
JOBS_POLLING_INTERVAL_SECONDS=2
JOBS_POOL_MAX=4
JOBS_BATCH_SIZE=10
MESSAGE_SEND_MAX_ATTEMPTS=5
MESSAGE_SEND_RETRY_DELAY_SECONDS=10

# ---------------------------------------------------------------- Real-time (Socket.IO)
REALTIME_ENABLED=true
# none = single instance; postgres = several web instances (uses LISTEN/NOTIFY, no Redis).
REALTIME_ADAPTER=none
REALTIME_REVALIDATE_SECONDS=60

# ---------------------------------------------------------------- Webhooks & messaging channels
# Enabled providers, comma separated: telegram, messenger, instagram, whatsapp. Empty = none.
# Each provider needs its external account/app (see documentation/HANDOVER.md §External services).
CHANNEL_PROVIDERS=
WEBHOOK_BODY_LIMIT=1mb
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_DELAY_SECONDS=30
WEBHOOK_RETENTION_DAYS=30
WEBHOOK_RATE_LIMIT_PER_MINUTE=1200

# ---------------------------------------------------------------- Meta (Messenger / Instagram / WhatsApp)
# [PROD, when messenger/instagram/whatsapp are enabled] From developers.facebook.com → your app.
META_APP_ID=
META_APP_SECRET=
# Any random string; entered again in the Meta webhook settings (openssl rand -hex 16).
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v24.0
# Instagram API with Instagram Login (Meta app → Instagram → API setup).
META_IG_APP_ID=
META_IG_APP_SECRET=
# WhatsApp Embedded Signup configuration id (requires Meta Tech Provider status). Leave empty to keep it disabled.
META_WA_CONFIG_ID=

# ---------------------------------------------------------------- Development / tests only (ignored or refused in production)
# FAKE_PROVIDER_SECRET=         # enables the "fake" channel provider (refused when NODE_ENV=production)
# TELEGRAM_API_BASE=            # mock Telegram server (ignored in production)
# META_GRAPH_BASE= / META_IG_GRAPH_BASE= / META_IG_API_BASE=   # mock Meta servers (ignored in production)
# TEST_DATABASE_URL=postgres://sscrm_app:<pw>@localhost:5432/sscrm_test
# TEST_DATABASE_MIGRATION_URL=postgres://sscrm_owner:<pw>@localhost:5432/sscrm_test
# TEST_APP_DB_ROLE=sscrm_app
