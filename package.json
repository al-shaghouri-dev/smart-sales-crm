{
  "name": "smart-sales-crm",
  "version": "5.0.0-alpha.1",
  "private": true,
  "description": "Multi-tenant sales & customer-messaging CRM platform",
  "main": "server/index.js",
  "scripts": {
    "dev": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "platform:admin": "node scripts/create-platform-admin.js",
    "company:create": "node scripts/create-company.js",
    "test": "node --test --test-concurrency=1 --test-reporter=spec \"test/**/*.test.js\" \"test/**/*.test.mjs\" \"legacy/test/*.test.js\"",
    "test:server": "node --test --test-concurrency=1 --test-reporter=spec \"test/server/*.test.js\"",
    "test:web": "node --test --test-concurrency=1 --test-reporter=spec \"test/web/*.test.mjs\"",
    "legacy": "node legacy/server.js",
    "legacy:create-admin": "node legacy/scripts/create-admin.js",
    "jobs:subscriptions": "node scripts/run-subscription-maintenance.js",
    "start:web": "node server/index.js --role=web",
    "start:worker": "node server/index.js --role=worker",
    "secrets:rotate": "node scripts/rotate-encryption-keys.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@socket.io/postgres-adapter": "^0.5.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "i18next": "^26.7.1",
    "knex": "^3.3.0",
    "lucide-react": "^1.67.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.1.11",
    "react-router-dom": "^7.18.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "supertest": "^7.3.1",
    "vite": "^8.3.5"
  }
}
