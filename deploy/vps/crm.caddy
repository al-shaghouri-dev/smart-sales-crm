
# ---------------------------------------------------------------------------------------------------
# Smart Sales CRM — systemd service "crm" on 127.0.0.1:3002 (added by deploy-crm.ps1)
# Cloudflare (proxied) → Caddy → app. The visitor IP comes from CF-Connecting-IP.
# ---------------------------------------------------------------------------------------------------
crm.example.com {
	# Only Cloudflare may connect (file generated by crm-setup.sh on every deploy).
	import /etc/caddy/crm-cloudflare-only.caddy
	encode zstd gzip
	request_body {
		max_size 12MB
	}
	reverse_proxy 127.0.0.1:3002 {
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
	}
	log {
		output file /var/log/caddy/crm.log
	}
}
